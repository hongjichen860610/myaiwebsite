# 本地运行配置示例：复制为 .env 后填入自己的值
# 注意：.env 已被 .gitignore 忽略，请勿把真实密钥提交到仓库

# Moonshot / Kimi API Key（可选；不填则只跑本地检索与 Ollama）
MOONSHOT_API_KEY=

# 后台管理密码（http://localhost:8787/admin）
ADMIN_PASSWORD=

# ---------- AI 通道 ----------
# 首选通道：ollama（本地优先）| moonshot（外部优先）
AI_PRIMARY=ollama

# 是否启用本地 Ollama：1 启用 / 0 禁用
OLLAMA_ENABLED=1

# 指定本地模型名；留空则自动使用 /api/tags 里的第一个模型
OLLAMA_MODEL=

# 本地模型推理参数（可选）
OLLAMA_TIMEOUT_MS=
OLLAMA_TEMPERATURE=
OLLAMA_MIN_TOKENS=

# 以下为可选配置，一般无需修改
# PORT=8787
# HOST=0.0.0.0
# MOONSHOT_MODEL=
# MOONSHOT_API_URL=
# RATE_LIMIT_PER_MIN=
# UPSTREAM_TIMEOUT_MS=
